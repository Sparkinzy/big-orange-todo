{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StickTodo",
  "version": "0.1.0",
  "identifier": "cn.jybckj.sticktodo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "便利贴",
        "width": 340,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
